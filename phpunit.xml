<?xml version="1.0" encoding="UTF-8"?>
<!--
    phpunit.xml

    إعداد بيئة الاختبار للمشروع.
    
    المبدأ المعتمد:
      - كل Test يعمل على قاعدة بيانات منفصلة في الذاكرة (sqlite :memory:)
      - كل Test مستقل — لا يؤثر على غيره
      - نستخدم RefreshDatabase trait لتنظيف البيانات بين كل Test
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>

    <php>
        <!--
            متغيرات بيئة الاختبار
            تُستخدَم فقط أثناء تشغيل الاختبارات
            لا تؤثر على .env الأصلي
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>

        <!--
            SQLite in-memory: قاعدة بيانات مؤقتة في الذاكرة
            سريعة جداً للاختبارات ولا تحتاج MySQL server
            تُنشأ من جديد لكل Test Suite
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <!--
            Sync driver: بدل Queue — يُنفِّذ Jobs فوراً
            يسهّل اختبار الـ Jobs بدون Queue worker
        -->
        <env name="QUEUE_CONNECTION" value="sync"/>

        <!-- Cache في الذاكرة للاختبارات -->
        <env name="CACHE_STORE" value="array"/>

        <!-- Session في الذاكرة للاختبارات -->
        <env name="SESSION_DRIVER" value="array"/>

        <!-- Mail Fake — لا يرسل emails حقيقية أثناء الاختبارات -->
        <env name="MAIL_MAILER" value="array"/>

        <!-- Broadcast Log driver — لا يُرسل لـ Pusher أثناء الاختبارات -->
        <env name="BROADCAST_CONNECTION" value="log"/>

        <!-- Filesystem Local للاختبارات -->
        <env name="FILESYSTEM_DISK" value="local"/>

        <!-- Sanctum Stateful Domains للاختبارات -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost"/>
    </php>

</phpunit>
